# Application Configuration
APP_NAME=AI Data Analyst Agent
APP_ENV=development
DEBUG=True

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./data_analyst.db

# Security & Authentication
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20

# Email / SMTP Configuration
# When SMTP is not configured, password reset tokens are safely logged in dev mode
# and contact requests offer a direct Gmail/email compose fallback.
# For Gmail SMTP:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter details below (do not commit actual passwords to git):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dataanalystagent@gmail.com
SMTP_PASSWORD=your_16_character_app_password_here
SMTP_FROM_EMAIL=dataanalystagent@gmail.com
SMTP_FROM_NAME=AI Data Analyst Agent
SMTP_TLS=True

# Storage Directories
DATA_DIR=data
REPORTS_DIR=reports
UPLOAD_DIR=uploads
