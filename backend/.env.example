# Application Configuration
APP_NAME=AI Data Analyst Agent
APP_ENV=development

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./data_analyst.db

# JWT Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password Reset & Email Delivery Configuration (SMTP)
# When SMTP is not configured, the backend logs password reset links in dev mode
# and informs the user to use the Gmail/Email compose fallback.
#
# To enable real email delivery (e.g., using Gmail SMTP):
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in the values below (DO NOT commit actual secrets or app passwords to git):
#
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dataanalystagent@gmail.com
SMTP_PASSWORD=your_16_character_app_password_here
SMTP_FROM_EMAIL=dataanalystagent@gmail.com
SMTP_FROM_NAME=AI Data Analyst Agent
SMTP_TLS=true

# File Storage Configuration
MAX_UPLOAD_SIZE_MB=50
STORAGE_DIR=storage
